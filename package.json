{
  "name": "rulz-ai-tools-suite",
  "productName": "RulZ AI Tools Suite",
  "version": "1.0.2",
  "description": "One launcher for the RulZ AI tools: browse, install, update and launch every app.",
  "main": "./out/main/index.js",
  "author": "RulZ",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "sync-catalog": "python tools/sync_catalog.py"
  },
  "dependencies": {
    "extract-zip": "2.0.1"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "clsx": "2.1.1",
    "electron": "44.9.3",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "lucide-react": "0.544.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "4.1.12",
    "zustand": "5.0.8"
  }
}
