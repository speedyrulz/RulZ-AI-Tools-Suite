{
  "name": "rulz-coding-agent",
  "productName": "RulZ Coding Agent",
  "version": "0.7.0",
  "description": "Describe an app in plain English and let a local AI model served by RulZ LLM Suite build it.",
  "main": "./out/main/index.js",
  "author": "RulZ",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "clsx": "2.1.1",
    "highlight.js": "11.11.1",
    "lucide-react": "0.544.0",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "ws": "8.22.0",
    "zod": "4.1.12",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "24.7.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.9.3",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "4.1.12"
  }
}
